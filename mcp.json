{
  "mcpServers": {
    "discord-fleet-status": {
      "command": "npm",
      "args": [
        "start"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}/mcp/status",
      "env": {
        "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}",
        "DISCORD_GUILD_ID": "${DISCORD_GUILD_ID}",
        "DISCORD_BRIDGE_HEALTH_URL": "${DISCORD_BRIDGE_HEALTH_URL}",
        "DISCORD_BRIDGE_CALLBACK_TOKEN": "${DISCORD_BRIDGE_CALLBACK_TOKEN}",
        "DISCORD_BRIDGE_CALLBACK_URL": "${DISCORD_BRIDGE_CALLBACK_URL}"
      }
    },
    "discord-fleet-manage": {
      "command": "npm",
      "args": [
        "start"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}/mcp/manage",
      "env": {
        "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}",
        "DISCORD_GUILD_ID": "${DISCORD_GUILD_ID}",
        "DISCORD_BRIDGE_CALLBACK_TOKEN": "${DISCORD_BRIDGE_CALLBACK_TOKEN}",
        "DISCORD_BRIDGE_CALLBACK_URL": "${DISCORD_BRIDGE_CALLBACK_URL}"
      }
    }
  }
}
