{
  "name": "discord-fleet-mcp",
  "version": "0.3.36",
  "private": true,
  "type": "module",
  "description": "MCP server: Discord fleet status + manage in one server (bridge /healthz, Discord REST reads, confirm-gated post/moderation; DISCORD_FLEET_READ_ONLY on hides writes)",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/env.test.ts test/tools.test.ts test/stdio.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "main": "dist/index.js"
}
