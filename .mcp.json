{
  "mcpServers": {
    "discord-fleet": {
      "command": "node",
      "args": [
        "./node_modules/tsx/dist/cli.mjs",
        "src/index.ts"
      ],
      "cwd": "${GROK_PLUGIN_ROOT}/mcp/discord-fleet",
      "env": {
        "DISCORD_BOT_TOKEN": "${DISCORD_BOT_TOKEN}",
        "DISCORD_GUILD_ID": "${DISCORD_GUILD_ID}",
        "DISCORD_BRIDGE_HEALTH_URL": "${DISCORD_BRIDGE_HEALTH_URL}",
        "DISCORD_FLEET_READ_ONLY": "${DISCORD_FLEET_READ_ONLY}"
      }
    }
  }
}
